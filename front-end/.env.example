# Base URL the browser uses for the API.
#   Dev (recommended): /api  → proxied by Vite to API_PROXY_TARGET, so no CORS or
#                              certificate issues on any dev port.
#   Production build:  the API's public URL, e.g. https://api.example.com/api
VITE_API_URL=/api

# Where the Vite dev/preview proxy forwards /api (server-side only, not exposed to the browser).
#   php artisan serve:  http://localhost:8000   (default)
#   Lerd site:          https://statkick-api.test
API_PROXY_TARGET=http://localhost:8000
